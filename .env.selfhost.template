# ==================================================
# Enterprise Self-Hosted Environment Template
# ==================================================
# Steps:
# 1) Copy this file to .env.selfhost
# 2) Set all REQUIRED values
# 3) Start with:
#    docker-compose --env-file .env.selfhost -f docker-compose.selfhost.yml up -d --build

# -------------------------------
# REQUIRED: Database credentials
# -------------------------------
DB_NAME=promptqa
DB_USER=promptqa_user
DB_PASSWORD=replace-with-strong-password

# -------------------------------
# REQUIRED: Security secrets
# -------------------------------
JWT_SECRET_KEY=replace-with-long-random-secret
MCP_API_KEY=replace-with-strong-random-token

# -------------------------------
# REQUIRED: Self-Host License
# -------------------------------
# Issue a license key from Organization Settings > Self-Host License tab
SELF_HOST_LICENSE_KEY=
SELF_HOST_TENANT_SLUG=
SELF_HOST_VALIDATION_URL=https://app.fluxtest.io/api/v1/licensing/self-host/validate
# Optional: token for authenticating validation requests
SELF_HOST_LICENSE_VALIDATION_TOKEN=

# -------------------------------
# REQUIRED: Public URLs for frontend build/runtime
# -------------------------------
FRONTEND_DOMAIN=app.example.com
VITE_UNIFIED_API_URL=https://api.example.com
VITE_API_BASE_URL=https://api.example.com
VITE_SQL_API_URL=https://api.example.com/api/v1/sql
VITE_AI_API_URL=https://api.example.com/api/v1/ai
VITE_HEALING_API_URL=https://api.example.com/api/v1/healing
VITE_POLICY_API_URL=https://api.example.com/api/v1/policy
VITE_MCP_SERVER_URL=wss://api.example.com/mcp/ws
REACT_APP_API_BASE_URL=https://api.example.com
REACT_APP_MCP_SERVER_URL=wss://api.example.com/mcp/ws
UNIFIED_API_URL=http://unified-api:8000

# -------------------------------
# AI provider selection
# -------------------------------
# Use cloud model:
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Or use local Ollama:
# AI_PROVIDER=ollama
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=60000

# Optional model toggles
OPENAI_ENABLED=true
ANTHROPIC_ENABLED=false
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -------------------------------
# Port mappings
# -------------------------------
POSTGRES_PORT=5432
UNIFIED_API_PORT=8000
MCP_PORT=8001
JAVA_RUNNER_PORT=8080
FRONTEND_PORT=3000
OLLAMA_PORT=11434

# -------------------------------
# Container names (optional)
# -------------------------------
POSTGRES_CONTAINER_NAME=postgres-selfhost
UNIFIED_API_CONTAINER_NAME=unified-api-selfhost
MCP_CONTAINER_NAME=mcp-server-selfhost
JAVA_RUNNER_CONTAINER_NAME=java-runner-selfhost
FRONTEND_CONTAINER_NAME=react-frontend-selfhost
OLLAMA_CONTAINER_NAME=ollama-selfhost

# -------------------------------
# Runtime settings
# -------------------------------
MCP_AUTH_REQUIRED=true
MCP_DEBUG=false
SELENIUM_HEADLESS=true
LOG_LEVEL=INFO
VITE_MCP_AUTH_TOKEN=

# -------------------------------
# Resource limits (compose-level)
# Tune based on host capacity.
# -------------------------------
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1.0

UNIFIED_API_MEM_LIMIT=2g
UNIFIED_API_CPUS=2.0

MCP_MEM_LIMIT=1g
MCP_CPUS=1.0

JAVA_RUNNER_MEM_LIMIT=2g
JAVA_RUNNER_CPUS=2.0

FRONTEND_MEM_LIMIT=1g
FRONTEND_CPUS=1.0

# Ollama defaults are higher due to model runtime needs
OLLAMA_MEM_LIMIT=8g
OLLAMA_CPUS=4.0
