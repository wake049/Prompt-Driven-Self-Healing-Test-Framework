# ==================================================
# SaaS/Hosted Deployment Environment Template
# ==================================================
# Copy to a private file (for example .env.production.local) and fill values.
# Do not commit real secrets.

# Core environment
ENVIRONMENT=production
NODE_ENV=production

# Database (required)
DB_HOST=your-rds-or-db-host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://your_database_user:replace-with-strong-password@your-rds-or-db-host:5432/your_database_name

# Public URLs and domains
FRONTEND_DOMAIN=app.example.com
UNIFIED_API_URL=https://api.example.com
API_BASE_URL=https://api.example.com
REACT_APP_API_BASE_URL=https://api.example.com
REACT_APP_MCP_SERVER_URL=wss://api.example.com/mcp/ws

# Frontend build-time variables
VITE_UNIFIED_API_URL=https://api.example.com
VITE_API_BASE_URL=https://api.example.com
VITE_SQL_API_URL=https://api.example.com/api/v1/sql
VITE_AI_API_URL=https://api.example.com/api/v1/ai
VITE_HEALING_API_URL=https://api.example.com/api/v1/healing
VITE_POLICY_API_URL=https://api.example.com/api/v1/policy
VITE_MCP_SERVER_URL=wss://api.example.com/mcp/ws
VITE_MCP_AUTH_TOKEN=

# Security secrets (required)
JWT_SECRET_KEY=replace-with-long-random-secret
SESSION_SECRET=replace-with-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-base64-key
MCP_API_KEY=replace-with-strong-random-token
# Optional: require this header on license validation endpoint
# X-License-Validation-Token: <SELF_HOST_LICENSE_VALIDATION_TOKEN>
SELF_HOST_LICENSE_VALIDATION_TOKEN=

# AI providers (set whichever provider you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# AI behavior toggles
OPENAI_ENABLED=true
ANTHROPIC_ENABLED=false
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_PROVIDER=openai
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=60000

# Service behavior
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_AUTH_REQUIRED=true
MCP_DEBUG=false
DATABASE_OPTIONAL=true
SELENIUM_HEADLESS=true
LOG_LEVEL=INFO

# AWS logging (only if using docker-compose.aws.yml)
AWS_REGION=us-east-1
AWSLOGS_GROUP=/aws/ecs/self-healing-test-framework
AWSLOGS_STREAM_PREFIX_API=unified-api
AWSLOGS_STREAM_PREFIX_MCP=mcp-server
AWSLOGS_STREAM_PREFIX_FRONTEND=react-frontend
AWSLOGS_STREAM_PREFIX_RUNNER=java-runner
