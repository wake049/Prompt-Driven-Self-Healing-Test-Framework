{
  "manifest_version": 3,
  "name": "Prompt-Driven Test Recorder",
  "version": "0.4.0",
  "action": { "default_popup": "popup.html" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://localhost:3000/*", "https://*/*", "http://*/*"],
  "background": { 
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}