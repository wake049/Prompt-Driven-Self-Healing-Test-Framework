{
  "family": "java-runner-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::905418315067:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::905418315067:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "java-runner",
      "image": "905418315067.dkr.ecr.us-east-2.amazonaws.com/java-runner:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "UNIFIED_API_URL",
          "value": "https://testhelix.com"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "production"
        },
        {
          "name": "JAVA_OPTS",
          "value": "-Xmx1536m -Xms512m"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/java-runner",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}